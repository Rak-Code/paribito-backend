# ============================================================
# E-Commerce Application - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control!

# ============================================================
# MongoDB Configuration
# ============================================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ecommerce_db?retryWrites=true&w=majority&maxPoolSize=50&minPoolSize=5&maxIdleTimeMS=300000

# ============================================================
# JWT Configuration
# ============================================================
# Generate a strong secret with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================================
# Groq API Configuration (Optional - for AI features)
# ============================================================
GROQ_API_KEY=your_groq_api_key_here

# ============================================================
# Application URL Configuration
# ============================================================
# URL of your deployed application for keep-alive service
APP_URL=https://your-app-domain.com

# ============================================================
# Redis Cloud Configuration
# ============================================================
# Sign up at: https://app.redislabs.com/
# Get connection details from your Redis Cloud dashboard
REDIS_HOST=your-redis-cloud-host.cloud.redislabs.com
REDIS_PORT=12345
REDIS_PASSWORD=your_redis_password
REDIS_SSL_ENABLED=true

# ============================================================
# Razorpay Payment Gateway
# ============================================================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ============================================================
# Email Configuration
# ============================================================
# Email Provider: "aws-ses" (default, recommended) or "brevo"
EMAIL_PROVIDER=aws-ses

# Email addresses (must be verified in AWS SES for sandbox mode)
FROM_EMAIL=noreply@yourdomain.com
FROM_EMAIL_NAME=Your Company Name
ADMIN_EMAIL=admin@yourdomain.com,admin2@yourdomain.com

# ============================================================
# AWS SES Configuration (Default Provider)
# ============================================================
# How to obtain AWS SES SMTP credentials:
# 1. Sign in to AWS Console: https://console.aws.amazon.com/ses/
# 2. Navigate to: Amazon SES > SMTP Settings
# 3. Click "Create SMTP Credentials"
# 4. Follow the wizard to create an IAM user with SMTP credentials
# 5. Download and save the SMTP username and password
# 6. Verify your sender email address in SES console (required for sandbox mode)
# 7. Request production access if you need to send to unverified addresses
#
# Note: In sandbox mode, you can only send to verified email addresses
# Region: eu-north-1 (Stockholm) - change if using a different region
AWS_SES_SMTP_USERNAME=AKIAIOSFODNN7EXAMPLE
AWS_SES_SMTP_PASSWORD=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_SES_REGION=eu-north-1

AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1

# ============================================================
# Brevo Email Configuration (Alternative Provider)
# ============================================================
# Sign up at: https://www.brevo.com/
# Free tier: 300 emails/day
# Get credentials from: Settings > SMTP & API
BREVO_SMTP_LOGIN=your_brevo_smtp_login
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_API_KEY=your_brevo_api_key

# ============================================================
# Cloudflare R2 Storage Configuration
# ============================================================
# Sign up at: https://dash.cloudflare.com/
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=ecommerce-images
R2_PUBLIC_URL=https://your-bucket.r2.dev

# ============================================================
# CORS Configuration (Optional)
# ============================================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# ============================================================
# Application Configuration (Optional)
# ============================================================
# Server port (default: 8080)
# SERVER_PORT=8080

# Reminder delays in minutes
# CART_REMINDER_DELAY=30
# WISHLIST_REMINDER_DELAY=60
