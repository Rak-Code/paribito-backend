{
  "info": {
    "name": "Razorpay Payment Integration",
    "description": "Collection for testing Razorpay payment integration endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Razorpay Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}",
            "description": "JWT token from login"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderId\": \"ORDER123\",\n  \"amount\": 1000.00\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/payments/razorpay/create-order",
          "host": ["{{base_url}}"],
          "path": ["api", "payments", "razorpay", "create-order"]
        },
        "description": "Creates a Razorpay order and returns order details including razorpayOrderId"
      },
      "response": []
    },
    {
      "name": "2. Verify Razorpay Payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"razorpayOrderId\": \"order_MNOPqrstuvwxyz\",\n  \"razorpayPaymentId\": \"pay_ABCDefghijklmn\",\n  \"razorpaySignature\": \"signature_string_from_razorpay\",\n  \"orderId\": \"ORDER123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/payments/razorpay/verify",
          "host": ["{{base_url}}"],
          "path": ["api", "payments", "razorpay", "verify"]
        },
        "description": "Verifies the Razorpay payment signature and updates payment status"
      },
      "response": []
    },
    {
      "name": "3. Refund Razorpay Payment (Admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_jwt_token}}",
            "description": "Admin JWT token"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/payments/razorpay/refund/:paymentId?amount=1000.00",
          "host": ["{{base_url}}"],
          "path": ["api", "payments", "razorpay", "refund", ":paymentId"],
          "query": [
            {
              "key": "amount",
              "value": "1000.00",
              "description": "Amount to refund"
            }
          ],
          "variable": [
            {
              "key": "paymentId",
              "value": "payment_id_here"
            }
          ]
        },
        "description": "Initiates a refund for a completed Razorpay payment (Admin only)"
      },
      "response": []
    },
    {
      "name": "4. Get Payment by Order ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/payments/order/:orderId",
          "host": ["{{base_url}}"],
          "path": ["api", "payments", "order", ":orderId"],
          "variable": [
            {
              "key": "orderId",
              "value": "ORDER123"
            }
          ]
        },
        "description": "Retrieves payment details by order ID"
      },
      "response": []
    },
    {
      "name": "5. Get Payment by Payment ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/payments/:paymentId",
          "host": ["{{base_url}}"],
          "path": ["api", "payments", ":paymentId"],
          "variable": [
            {
              "key": "paymentId",
              "value": "payment_id_here"
            }
          ]
        },
        "description": "Retrieves payment details by payment ID"
      },
      "response": []
    },
    {
      "name": "6. Get All Payments (Admin)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/payments",
          "host": ["{{base_url}}"],
          "path": ["api", "payments"]
        },
        "description": "Retrieves all payments (Admin only)"
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "your_jwt_token_here",
      "type": "string"
    },
    {
      "key": "admin_jwt_token",
      "value": "your_admin_jwt_token_here",
      "type": "string"
    }
  ]
}
